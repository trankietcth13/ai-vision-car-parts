<?xml version="1.0" encoding="utf-8"?>
<!-- 3D component model block, filled by ModelPanel: viewer, controls, part chips and the selected part's check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/modelFrame"
        android:layout_width="match_parent"
        android:layout_height="280dp">

        <com.enginebay.vision.ModelView
            android:id="@+id/modelView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- the selected part's name, pinned to the part on the model -->
        <TextView
            android:id="@+id/anchorLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_anchor"
            android:maxWidth="220dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/modelBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/model_badge"
            android:textAppearance="?attr/textAppearanceLabelSmall" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/modelHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/model_hint"
            android:textAppearance="?attr/textAppearanceBodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explode"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:checkable="true"
            android:text="@string/model_explode" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/resetView"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/model_reset" />
    </LinearLayout>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/partChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingVertical="0dp"
        app:singleSelection="true" />

    <TextView
        android:id="@+id/partName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:visibility="gone" />

    <TextView
        android:id="@+id/partCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/model_pick_hint"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/model_note"
        android:textAppearance="?attr/textAppearanceBodySmall" />
</LinearLayout>
