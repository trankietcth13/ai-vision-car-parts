<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EngineBay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/obsidian_black</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:colorBackground">@color/canvas_bg_light</item>
        <item name="colorSurface">@color/card_surface_light</item>
        <item name="colorSurfaceContainer">@color/card_surface_light</item>
        <item name="colorSurfaceContainerLow">@color/canvas_bg_light</item>
        <item name="colorSurfaceContainerHigh">@color/pill_neutral_light</item>
        <item name="colorSurfaceContainerHighest">@color/pill_neutral_light</item>
        <item name="colorOutline">@color/card_stroke_light</item>
        <item name="colorOutlineVariant">@color/card_stroke_light</item>
        <item name="colorOnSurface">@color/text_primary_light</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/canvas_bg_light</item>
        <item name="materialButtonStyle">@style/Widget.EngineBay.Button</item>
    </style>

    <style name="Widget.EngineBay.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EngineBay.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EngineBay.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.EngineBay.Button.Icon" parent="Widget.Material3.Button.IconButton.Filled.Tonal">
        <item name="android:minWidth">36dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.EngineBay.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>
</resources>
